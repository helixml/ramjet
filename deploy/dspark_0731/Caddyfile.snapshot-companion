# Insert these handlers before the existing broad `handle /metrics*` route in
# the node-local :9105 server. The Caddy service account must be a member of
# GIDs 12004 and 12005, and must never be added to snapshot session GID 12000.

handle /metrics/snapshot/0 {
	rewrite * /metrics
	reverse_proxy unix//run/ramjet-snapshot-metrics-a/metrics.sock
}

handle /metrics/snapshot/1 {
	rewrite * /metrics
	reverse_proxy unix//run/ramjet-snapshot-metrics-b/metrics.sock
}
