[Unit]
Description=Export, analyze, and retain Ramjet route journals
After=ramjet-route-journal-collect.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
StateDirectory=ramjet-journal
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/libexec/ramjet-route-journal/route_journal_archive.py --state-dir /var/lib/ramjet-journal maintain --day yesterday --retention-days 30
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/ramjet-journal
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictNamespaces=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
