# syntax=docker/dockerfile:1.7
ARG RUST_DEPS_IMAGE=ghcr.io/helixml/ramjet:rust-deps-sha256-ad20746f3f4ad52fc14362114f420a157fe8e48e73943bdb046c34eddee427b2
ARG OCI_REVISION=unknown
FROM ${RUST_DEPS_IMAGE} AS build
WORKDIR /src

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
RUN cargo build --release --locked --offline \
        --bin ramjet-snapshot-companion \
        --bin ramjet-attestation-provisioner \
    && cp target/release/ramjet-snapshot-companion /ramjet-snapshot-companion \
    && cp target/release/ramjet-attestation-provisioner /ramjet-attestation-provisioner

FROM gcr.io/distroless/cc-debian12
ARG OCI_REVISION
LABEL org.opencontainers.image.source="https://github.com/helixml/ramjet"
LABEL org.opencontainers.image.version="0.4.0"
LABEL org.opencontainers.image.revision="${OCI_REVISION}"
COPY --from=build /ramjet-snapshot-companion /ramjet-snapshot-companion
COPY --from=build /ramjet-attestation-provisioner /ramjet-attestation-provisioner
ENTRYPOINT ["/ramjet-snapshot-companion"]
