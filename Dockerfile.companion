# syntax=docker/dockerfile:1.7
ARG RUST_DEPS_IMAGE=ghcr.io/helixml/ramjet:rust-deps-sha256-9894f4b88295b81874f2e0a837c1b49014b6a139318ce0556b34f450dc745389
ARG OCI_REVISION=unknown
FROM ${RUST_DEPS_IMAGE} AS build
WORKDIR /src

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
RUN cargo build --release --locked --offline \
        --bin mini-dynamo-snapshot-companion \
        --bin mini-dynamo-attestation-provisioner \
    && cp target/release/mini-dynamo-snapshot-companion /mini-dynamo-snapshot-companion \
    && cp target/release/mini-dynamo-attestation-provisioner /mini-dynamo-attestation-provisioner

FROM gcr.io/distroless/cc-debian12
ARG OCI_REVISION
LABEL org.opencontainers.image.source="https://github.com/helixml/ramjet"
LABEL org.opencontainers.image.version="0.1.0"
LABEL org.opencontainers.image.revision="${OCI_REVISION}"
COPY --from=build /mini-dynamo-snapshot-companion /mini-dynamo-snapshot-companion
COPY --from=build /mini-dynamo-attestation-provisioner /mini-dynamo-attestation-provisioner
ENTRYPOINT ["/mini-dynamo-snapshot-companion"]
