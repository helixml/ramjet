# syntax=docker/dockerfile:1.7
FROM rust:1.95-bookworm AS build
WORKDIR /src

# Keep the expensive dependency graph in an exported image layer. Drone's
# publisher uses a fresh Docker daemon for every build, so BuildKit cache
# mounts alone cannot accelerate the next run.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
RUN mkdir -p src/bin \
    && printf 'fn main() {}\n' > src/bin/mini-dynamo-snapshot-companion.rs \
    && cargo build --release --locked --bin mini-dynamo-snapshot-companion \
    && rm -rf src \
    && rm -f target/release/mini-dynamo-snapshot-companion \
    && rm -f target/release/deps/mini_dynamo_snapshot_companion-* \
    && rm -rf target/release/.fingerprint/mini-dynamo-*

COPY src ./src
RUN cargo build --release --locked --bin mini-dynamo-snapshot-companion \
    && cp target/release/mini-dynamo-snapshot-companion /mini-dynamo-snapshot-companion

FROM gcr.io/distroless/cc-debian12
LABEL org.opencontainers.image.source="https://github.com/helixml/mini-dynamo"
COPY --from=build /mini-dynamo-snapshot-companion /mini-dynamo-snapshot-companion
ENTRYPOINT ["/mini-dynamo-snapshot-companion"]
